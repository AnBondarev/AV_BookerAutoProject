pipeline {

    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Run tests') {
            steps {
                sh 'chmod +x run-test.sh'
                sh './run-test.sh'
            }
        }

        stage('Allure Report') {
            steps {
                allure results: [[path: 'allure-results']]
            }
        }
    }
}